---
/**
 * News index. getNews() already returns the canonical date-desc, nulls-last
 * order (single sort in lib/data.ts) — the old page-level re-sort is gone.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getNews } from "@/lib/data";

const items = await getNews(Astro.locals);
const total = items.length;

const formatListDate = (date: string) =>
  new Date(date).toLocaleDateString("en-US", {
    month: "short",
    day: "2-digit",
    year: "numeric",
  });

const pad2 = (n: number) => n.toString().padStart(2, "0");
---
<BaseLayout title="News">
  <section class="px-edge-margin-mobile lg:px-edge-margin-desktop py-section-gap">
    <div class="max-w-[1440px] mx-auto">
      <h1 class="font-display text-display-xl-mobile lg:text-display-xl uppercase tracking-tighter mb-section-gap">
        News
      </h1>

      {total === 0 ? (
        <p class="font-body text-body-lg text-on-surface-variant">
          No entries.
        </p>
      ) : (
        <div class="border-t border-structural-gray">
          {items.map((item, i) => (
            <article class="group border-b border-structural-gray hover:bg-surface-container-low transition-colors">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter py-gutter">
                <div class="md:col-span-2 font-display text-label-caps uppercase text-on-surface-variant">
                  <span class="text-primary">{pad2(i + 1)}</span>
                  <span> / {pad2(total)}</span>
                  {item.date && (
                    <span class="block mt-1">
                      {formatListDate(item.date)}
                    </span>
                  )}
                </div>

                <div class="md:col-span-7">
                  <a href={`/news/${item.slug}`} class="block">
                    <h2 class="font-display text-headline-lg text-primary group-hover:translate-x-2 transition-transform duration-200">
                      {item.title}
                    </h2>
                    {item.summary && (
                      <p class="font-body text-body-md text-on-surface-variant mt-2">
                        {item.summary}
                      </p>
                    )}
                  </a>
                </div>

                <div class="md:col-span-3 flex items-start justify-end">
                  <span
                    aria-hidden="true"
                    class="font-display text-headline-lg text-primary opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                  >
                    →
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
