---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getNewsItem } from "@/lib/data";

const { slug } = Astro.params;
const item = await getNewsItem(Astro.locals, slug ?? "");
if (!item) return Astro.rewrite("/404");
---
<BaseLayout title={item.title} ogImage={item.image} ogType="article">
  <section class="px-edge-margin-mobile lg:px-edge-margin-desktop pt-gutter">
    <div class="max-w-[1440px] mx-auto">
      <a
        href="/news"
        class="font-display text-label-caps uppercase text-on-surface-variant hover:text-primary inline-flex items-center gap-1"
      >
        ← News
      </a>
    </div>
  </section>

  <header class="px-edge-margin-mobile lg:px-edge-margin-desktop py-section-gap border-b border-structural-gray">
    <div class="max-w-[1440px] mx-auto">
      {item.date && (
        <p class="font-display text-label-caps uppercase text-on-surface-variant mb-4">
          {new Date(item.date).toLocaleDateString("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric",
          })}
        </p>
      )}
      <h1 class="font-display text-display-xl-mobile lg:text-display-xl text-primary uppercase leading-none">
        {item.title}
      </h1>
    </div>
  </header>

  {item.image && (
    <section class="px-edge-margin-mobile lg:px-edge-margin-desktop py-section-gap">
      <div class="max-w-[1440px] mx-auto bg-surface-container overflow-hidden">
        <img
          src={item.image}
          alt={item.title}
          width="2048"
          height="1365"
          fetchpriority="high"
          decoding="async"
          class="w-full h-auto"
        />
      </div>
    </section>
  )}

  <section class="px-edge-margin-mobile lg:px-edge-margin-desktop pb-section-gap">
    <div class="max-w-[1440px] mx-auto">
      <div class="font-body text-body-lg text-on-surface max-w-3xl space-y-6">
        {item.summary && (
          <p class="text-on-surface-variant">{item.summary}</p>
        )}
        {item.body && <p class="whitespace-pre-line">{item.body}</p>}
      </div>
    </div>
  </section>
</BaseLayout>
