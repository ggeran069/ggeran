---
import { eq } from "drizzle-orm";
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import { actions } from "astro:actions";

// PRG: the action returned data = success → back to the section list.
const result = Astro.getActionResult(actions.news.update);
if (result?.data) return Astro.redirect("/admin/news");
import NewsForm from "@/components/admin/NewsForm.astro";
import { getDb } from "@/lib/db";
import { news } from "@/db/schema";

const db = getDb(Astro.locals);
if (!db) return Astro.rewrite("/404");

const { id } = Astro.params;
const rows = await db.select().from(news).where(eq(news.id, Number(id))).limit(1);
const row = rows[0];
if (!row) return Astro.rewrite("/404");
---
<AdminLayout title={`Edit: ${row.title}`}>
  <div class="px-edge-margin-mobile lg:px-edge-margin-desktop py-gutter">
    <div class="max-w-[1100px] mx-auto">
      <AdminHeader title={`Edit: ${row.title}`} />
      <NewsForm mode="update" defaults={row} />
    </div>
  </div>
</AdminLayout>
