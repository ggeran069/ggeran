---
import { desc } from "drizzle-orm";
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import { getDb } from "@/lib/db";
import { getNews } from "@/lib/data";
import { news } from "@/db/schema";
import { actions } from "astro:actions";

const db = getDb(Astro.locals);
const rows = db
  ? (await db.select().from(news).orderBy(desc(news.date))).map((r) => ({
      id: r.id as number | undefined,
      title: r.title,
      date: r.date,
    }))
  : (await getNews(Astro.locals)).map((n) => ({
      id: undefined as number | undefined,
      title: n.title,
      date: n.date,
    }));

const delError = Astro.getActionResult(actions.news.delete)?.error?.message ?? null;
---
<AdminLayout title="News">
  <div class="px-edge-margin-mobile lg:px-edge-margin-desktop py-gutter">
    <div class="max-w-[1100px] mx-auto">
      <AdminHeader title="News" />

      {!db && (
        <p class="font-body text-caption text-on-surface-variant border border-structural-gray p-gutter mb-section-gap">
          Showing seed preview — set <code>DATABASE_URL</code> and run
          <code>npm run db:push</code> to enable editing.
        </p>
      )}

      {delError && <p class="text-destructive text-sm mb-gutter">{delError}</p>}

      <div class="mb-section-gap">
        <a href="/admin/news/new" class="btn btn-primary">+ New entry</a>
      </div>

      <div class="border border-structural-gray">
        <div class="grid grid-cols-[1fr_10rem_8rem] gap-gutter px-gutter py-unit font-display text-label-caps uppercase text-on-surface-variant border-b border-structural-gray">
          <span>Title</span>
          <span>Date</span>
          <span></span>
        </div>
        {rows.length === 0 && (
          <p class="px-gutter py-gutter text-on-surface-variant">No entries yet.</p>
        )}
        {rows.map((n) => (
          <div class="grid grid-cols-[1fr_10rem_8rem] gap-gutter px-gutter py-unit items-center border-b border-structural-gray last:border-0">
            <span class="truncate">{n.title}</span>
            <span class="text-on-surface-variant">{n.date ?? "—"}</span>
            <div class="flex gap-unit">
              {db && n.id !== undefined && (
                <>
                  <a href={`/admin/news/${n.id}`} class="btn btn-outline btn-sm">Edit</a>
                  <form method="POST" action={actions.news.delete}>
                    <input type="hidden" name="id" value={n.id} />
                    <button type="submit" class="btn btn-outline btn-sm">Delete</button>
                  </form>
                </>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>
