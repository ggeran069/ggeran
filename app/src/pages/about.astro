---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSiteContent } from "@/lib/data";

const c = await getSiteContent(Astro.locals);
const paragraphs = (c.aboutBio ?? "")
  .split(/\n{2,}/)
  .map((s) => s.trim())
  .filter(Boolean);
const exhibitions = (c.aboutExhibitions ?? "")
  .split(/\n/)
  .map((s) => s.trim())
  .filter(Boolean);
---
<BaseLayout title="Biography" ogImage={c.aboutPortrait}>
  <section class="px-edge-margin-mobile lg:px-edge-margin-desktop py-section-gap">
    <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter">
      <div class="lg:col-span-3">
        <h1 class="font-display text-display-xl-mobile lg:text-display-xl uppercase tracking-tighter">
          Biography
        </h1>
      </div>
      <div class="lg:col-span-8 lg:col-start-5 max-w-2xl">
        {c.aboutPortrait && (
          <div class="mb-section-gap max-w-xs">
            <img
              src={c.aboutPortrait}
              alt="Portrait of George Geranios"
              width="1000"
              height="1200"
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />
          </div>
        )}
        <div class="font-body text-body-lg text-on-surface space-y-6">
          {paragraphs.map((p) => <p>{p}</p>)}
          {exhibitions.length > 0 && (
            <>
              <h2 class="font-display text-headline-md uppercase pt-section-gap">
                Selected solo exhibitions
              </h2>
              <ul class="space-y-1">
                {exhibitions.map((e) => <li>{e}</li>)}
              </ul>
            </>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
